<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TeamManage.App.ViewModels"
             x:Class="TeamManage.App.Views.CreateClubPage"
             x:DataType="vm:CreateClubViewModel"
             Title="{Binding Title}">
    <VerticalStackLayout Padding="20" Spacing="14">
        <Label Text="Club name" FontAttributes="Bold" />
        <Entry Placeholder="e.g. St. Mary's GAA" Text="{Binding Name}" />

        <Label Text="{Binding ErrorMessage}" TextColor="Red"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

        <Button Text="Create Club" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
    </VerticalStackLayout>
</ContentPage>
