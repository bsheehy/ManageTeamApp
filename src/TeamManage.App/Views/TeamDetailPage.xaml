<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TeamManage.App.ViewModels"
             xmlns:dto="clr-namespace:TeamManage.Application.DTOs.Teams;assembly=TeamManage.Application"
             x:Class="TeamManage.App.Views.TeamDetailPage"
             x:DataType="vm:TeamDetailViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="{Binding ErrorMessage}" TextColor="Red"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <HorizontalStackLayout Spacing="10">
                <Button Text="View Matches" Command="{Binding ViewMatchesCommand}" />
                <Button Text="+ New Match" Command="{Binding CreateMatchCommand}" IsVisible="{Binding IsManager}" />
            </HorizontalStackLayout>

            <Label Text="Panel" FontSize="18" FontAttributes="Bold" />

            <CollectionView ItemsSource="{Binding Players}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No players added yet." Margin="0,10" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:TeamPlayerDto">
                        <Grid Padding="10,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="{Binding JerseyNumber}" FontAttributes="Bold" WidthRequest="30" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="{Binding FullName}" FontAttributes="Bold" />
                                <Label Text="{Binding Email}" FontSize="12" TextColor="Gray" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="Remove" FontSize="12"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TeamDetailViewModel}}, Path=RemovePlayerCommand}"
                                    CommandParameter="{Binding .}"
                                    IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:TeamDetailViewModel}}, Path=IsManager}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView HeightRequest="1" BackgroundColor="LightGray" IsVisible="{Binding IsManager}" />

            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsManager}">
                <Label Text="Add Player" FontSize="16" FontAttributes="Bold" />
                <Entry Placeholder="Full name" Text="{Binding NewPlayerFullName}" />
                <Entry Placeholder="Email" Keyboard="Email" Text="{Binding NewPlayerEmail}" />
                <Entry Placeholder="Jersey number (optional)" Keyboard="Numeric" Text="{Binding NewPlayerJerseyNumber}" />
                <Button Text="Add to Panel" Command="{Binding AddPlayerCommand}" IsEnabled="{Binding IsNotBusy}" />

                <Label IsVisible="{Binding LastGeneratedPassword, Converter={StaticResource StringNotEmptyConverter}}"
                       TextColor="DarkGreen">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="New player account created. Temporary password: " />
                            <Span Text="{Binding LastGeneratedPassword}" FontAttributes="Bold" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
