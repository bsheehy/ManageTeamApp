<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TeamManage.App.ViewModels"
             x:Class="TeamManage.App.Views.CreateMatchPage"
             x:DataType="vm:CreateMatchViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="Opponent" FontAttributes="Bold" />
            <Entry Placeholder="e.g. St. Mary's" Text="{Binding Opponent}" />

            <Label Text="Location" FontAttributes="Bold" />
            <Entry Placeholder="e.g. Home ground" Text="{Binding Location}" />

            <Label Text="Date" FontAttributes="Bold" />
            <DatePicker Date="{Binding MatchDate}" />

            <Label Text="Kick-off time" FontAttributes="Bold" />
            <TimePicker Time="{Binding MatchTime}" />

            <Label Text="Notes (optional)" FontAttributes="Bold" />
            <Editor Placeholder="Any notes for the squad" Text="{Binding Notes}" HeightRequest="80" />

            <Label Text="{Binding ErrorMessage}" TextColor="Red"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Button Text="Schedule Match" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
