<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TeamManage.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:TeamManage.App.Views"
    Title="TeamManage"
    FlyoutBehavior="Disabled">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="login" />

    <ShellContent
        Title="My Teams"
        ContentTemplate="{DataTemplate views:TeamsPage}"
        Route="teams" />

    <ShellContent
        Title="My Matches"
        ContentTemplate="{DataTemplate views:MatchesPage}"
        Route="matches" />

</Shell>
