<configuration>
  <!-- Scoped to this repo: avoids slow/unreachable private feeds configured globally on this machine. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
